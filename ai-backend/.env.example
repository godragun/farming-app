# Copy to .env and fill in (never commit real keys).
# PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }

ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=your-workspace/your-model
ROBOFLOW_MODEL_VERSION=1
ROBOFLOW_TASK=detect
ROBOFLOW_CONFIDENCE=40

# true = stub Early Blight result when key/model missing (Android UI testing)
ROBOFLOW_DEMO_MODE=true
