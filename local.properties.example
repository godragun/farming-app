## Copy to local.properties (gitignored) and fill in secrets locally.
## Never commit real API keys — this repo is public.

sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

# Existing Agri Lanka keys (optional for FieldGuard demos)
ROBOFLOW_API_KEY=
HUGGINGFACE_API_KEY=

# FieldGuard AI — OpenAI-compatible Chat Completions
# Meta Model API (hackathon):
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
LLM_API_KEY=

# Local Muse Glimmer via llama.cpp (example — use your laptop LAN IP):
# LLM_BASE_URL=http://192.168.1.20:8080/v1
# LLM_MODEL=muse-glimmer
# LLM_API_KEY=
