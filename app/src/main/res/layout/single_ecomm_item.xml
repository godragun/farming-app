<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ecommCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- Product image -->
        <ImageView
            android:id="@+id/ecommImage"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:adjustViewBounds="true"
            android:background="@color/surfaceVariant"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Availability badge -->
        <TextView
            android:id="@+id/ecommItemAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/round_borderless_general"
            android:backgroundTint="#CC2E7D0F"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="@string/auto_single_cart_item_in_stock_180"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            app:layout_constraintEnd_toEndOf="@id/ecommImage"
            app:layout_constraintTop_toTopOf="@id/ecommImage" />

        <!-- Content padding wrapper -->
        <LinearLayout
            android:id="@+id/cardContentWrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ecommImage">

            <TextView
                android:id="@+id/ecommtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/auto_single_ecomm_item_premium_organic_fert_187"
                android:textColor="@color/fontColor"
                android:textSize="13sp"
                android:textStyle="bold"
                android:lineSpacingExtra="1dp" />

            <TextView
                android:id="@+id/ecommretailer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/auto_activity_login_agri_lanka_3"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp" />

            <RatingBar
                android:id="@+id/ecommRating"
                style="@style/Widget.AppCompat.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:numStars="5"
                android:rating="4"
                android:stepSize="0.5"
                android:theme="@style/RatingBar" />

            <TextView
                android:id="@+id/ecommPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/auto_single_ecomm_item_rs_1200_188"
                android:textColor="@color/colorThird"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
