<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cartCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Product image -->
            <ImageView
                android:id="@+id/cartItemImage"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/round_borderless_general"
                android:backgroundTint="@color/surfaceVariant"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/buyBtnBarrier" />

            <!-- Product name -->
            <TextView
                android:id="@+id/itemNameCart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/auto_single_cart_item_natures_plus_organic_178"
                android:textColor="@color/fontColor"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cartItemImage"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Price -->
            <TextView
                android:id="@+id/itemPriceCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:text="@string/auto_single_cart_item_rs_469_179"
                android:textColor="@color/colorThird"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/cartItemImage"
                app:layout_constraintTop_toBottomOf="@id/itemNameCart" />

            <!-- Delete -->
            <ImageView
                android:id="@+id/removeCartBtn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="0dp"
                android:src="@drawable/ic_baseline_delete_forever_24"
                android:tint="@color/colorThird"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Qty control -->
            <LinearLayout
                android:id="@+id/quantityChangeCard"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/modern_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="6dp"
                app:layout_constraintStart_toEndOf="@id/cartItemImage"
                app:layout_constraintTop_toBottomOf="@id/itemPriceCart">

                <ImageButton
                    android:id="@+id/decreaseQtyBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:backgroundTint="#00FFFFFF"
                    app:srcCompat="@drawable/minus_icon" />

                <TextView
                    android:id="@+id/quantityCountEcomm"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/auto_fragment_ecommerce_item_1_62"
                    android:textColor="@color/fontColor"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/increaseQtyBtn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:backgroundTint="#00FFFFFF"
                    app:srcCompat="@drawable/add_icon" />
            </LinearLayout>

            <!-- Availability -->
            <TextView
                android:id="@+id/cartItemAvailability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/round_borderless_general"
                android:backgroundTint="#1A5DAE3A"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/auto_single_cart_item_in_stock_180"
                android:textColor="@color/greenDark"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/removeCartBtn" />

            <!-- Delivery + retailer row -->
            <TextView
                android:id="@+id/deliveryChargeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:text="@string/auto_single_cart_item_delivery_rs_181"
                android:textColor="@color/fontColor"
                android:textSize="11sp"
                android:textStyle="italic"
                app:layout_constraintStart_toEndOf="@id/cartItemImage"
                app:layout_constraintTop_toBottomOf="@id/quantityChangeCard" />

            <TextView
                android:id="@+id/deliveryChargeCart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/auto_single_cart_item_str_182_182"
                android:textColor="@color/fontColor"
                android:textSize="11sp"
                android:textStyle="italic"
                app:layout_constraintStart_toEndOf="@id/deliveryChargeTitle"
                app:layout_constraintTop_toBottomOf="@id/quantityChangeCard" />

            <TextView
                android:id="@+id/cartItemFirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/auto_single_cart_item_str_182_182"
                android:textColor="@color/fontColor"
                android:textSize="10sp"
                android:textStyle="italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/deliveryChargeCart"
                app:layout_constraintTop_toBottomOf="@id/cartItemAvailability" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/buyBtnBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="cartItemImage,deliveryChargeCart" />

            <!-- Buy button spanning full width -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cartItemBuyBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/auto_fragment_ecommerce_item_buy_now_73"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/buyBtnBarrier" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
