<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fieldguard_iot_nodes_title"
        android:textColor="@color/fontColor"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/fieldguard_iot_nodes_subtitle"
        android:textColor="@color/fontColor"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/iotStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/iotProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/fieldguard_iot_demo_controls"
        android:textColor="@color/fontColor"
        android:textStyle="bold"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/demoHumidCool"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:text="@string/fieldguard_iot_demo_humid"
                android:textSize="11sp" />

            <Button
                android:id="@+id/demoDryHot"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:text="@string/fieldguard_iot_demo_dry"
                android:textSize="11sp" />

            <Button
                android:id="@+id/demoOffline"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:text="@string/fieldguard_iot_demo_offline"
                android:textSize="11sp" />

            <Button
                android:id="@+id/demoMotionNight"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:text="@string/fieldguard_iot_demo_motion"
                android:textSize="11sp" />

            <Button
                android:id="@+id/demoReset"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/fieldguard_iot_demo_reset"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/nodesRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />
</LinearLayout>
