<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/incidentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fieldguard_incident_title"
            android:textColor="@color/fontColor"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incidentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/incidentFrame"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:background="@color/surfaceVariant"
            android:contentDescription="@string/fieldguard_frame_desc"
            android:scaleType="centerCrop" />

        <!-- Simulated IoT node panel -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/nodeLed"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/fieldguard_led_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fieldguard_node_title"
                        android:textColor="@color/fontColor"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/nodePattern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fieldguard_node_idle"
                        android:textColor="@color/fontColor"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nodeBuzzer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fieldguard_buzzer_off"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fieldguard_trace_heading"
            android:textColor="@color/fontColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/traceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fieldguard_decision_heading"
            android:textColor="@color/fontColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/decisionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface"
            android:padding="12dp"
            android:textColor="@color/fontColor"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/incidentProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
