<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@color/colorPrimary"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <!-- Avatar ring -->
    <com.google.android.material.circularreveal.cardview.CircularRevealCardView
        android:id="@+id/circularRevealCardView"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#33FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/navbarUserImage"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/ic_user_profile"
            android:scaleType="centerCrop" />
    </com.google.android.material.circularreveal.cardview.CircularRevealCardView>

    <ImageView
        android:id="@+id/navHeaderBrandLogo"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="Agri Lanka"
        android:padding="4dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Name -->
    <TextView
        android:id="@+id/navbarUserName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:text="User Name"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        app:layout_constraintStart_toEndOf="@+id/circularRevealCardView"
        app:layout_constraintEnd_toStartOf="@id/navHeaderBrandLogo"
        app:layout_constraintTop_toTopOf="@+id/circularRevealCardView" />

    <!-- City -->
    <TextView
        android:id="@+id/cityTextNavHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:text="City: —"
        android:textColor="#CCF0FFD0"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@+id/circularRevealCardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navbarUserName" />

    <!-- Divider -->
    <View
        android:id="@+id/navHeaderDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#44FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/circularRevealCardView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Email -->
    <TextView
        android:id="@+id/navbarUserEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="email@example.com"
        android:textColor="#CCF0FFD0"
        android:textSize="12sp"
        android:drawablePadding="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navHeaderDivider" />

    <!-- Post count -->
    <TextView
        android:id="@+id/navBarUserPostCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Posts: 0"
        android:textColor="#AAF0FFD0"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navbarUserEmail" />

</androidx.constraintlayout.widget.ConstraintLayout>
