<resources>

    <!-- ══════════════════════════════════════
         Base application theme  (DayNight)
         ══════════════════════════════════════ -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Brand colours -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/colorThird</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface / background (DayNight-aware via color qualifiers) -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/fontColor</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>

        <!-- Elevation overlay in dark mode (Material Design standard) -->
        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/colorPrimary</item>

        <!-- Typography -->
        <item name="fontFamily">@font/lato</item>
        <item name="android:textColor">@color/fontColor</item>

        <!-- Status / nav bar -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>

        <!-- Legacy compat -->
        <item name="colorAccent">@color/colorPrimary</item>
    </style>

    <!-- Auth / no-action-bar screens -->
    <style name="AppTheme2" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/fontColor</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="fontFamily">@font/lato</item>
        <item name="android:textColor">@color/fontColor</item>
        <item name="colorAccent">@color/colorPrimary</item>
    </style>

    <!-- ══════════════════════════════════════
         Component styles
         ══════════════════════════════════════ -->

    <style name="RatingBar" parent="AppTheme">
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorControlNormal">@color/secondary2</item>
    </style>

    <!-- Chip: pill-shaped filter tag -->
    <style name="ChipFuturistic" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_states</item>
        <item name="chipStrokeColor">@color/colorPrimary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/fontColor</item>
        <item name="chipMinHeight">34dp</item>
    </style>

    <!-- Primary filled button -->
    <style name="ActionButtonFuturistic" parent="Widget.MaterialComponents.Button">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/colorThird</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <!-- Outlined secondary button -->
    <style name="OutlineButtonFuturistic" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <!-- Card surface -->
    <style name="ModernCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <!-- Navigation drawer item text / icon -->
    <style name="NavDrawerTextStyle">
        <item name="android:textColor">@color/fontColor</item>
        <item name="android:textSize">15sp</item>
    </style>

</resources>
